DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/gmec_corporation"

NEXTAUTH_SECRET="generate-a-random-32-byte-base64-string"
NEXTAUTH_URL="http://localhost:3000"

# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Get sandbox keys from https://developer.paypal.com -> Apps & Credentials -> Sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sandbox-client-id..."
PAYPAL_CLIENT_SECRET="sandbox-client-secret..."
# "sandbox" while testing, "live" once you switch to real Live app credentials
PAYPAL_MODE="sandbox"

# Order confirmation emails: SMTP is tried first (real mailbox, e.g. Hostinger),
# falling back to Resend if SMTP isn't configured. Skipped silently if neither is set.
#
# SMTP (recommended if you already have a real business mailbox — no domain
# verification wait, works immediately for any customer):
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="info@gmeccorporation.com"
SMTP_PASS="your-mailbox-password"
SMTP_FROM="GMEC Corporation <info@gmeccorporation.com>"
#
# Resend fallback — get an API key from https://resend.com/api-keys. Verify your
# sending domain in Resend, then set RESEND_FROM_EMAIL to an address on that domain.
# Until a domain is verified, Resend only delivers to your own account email.
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="GMEC Corporation <onboarding@resend.dev>"

# Used to build absolute links (invoice URLs in emails, Organization structured data).
# Set this to your real deployed domain once it's live.
NEXT_PUBLIC_SITE_URL="https://gmeccorporation.com"

# Royal Mail Click & Drop API — used by admins to create shipping labels after an
# order is paid. Get the API key from your Click & Drop account (Settings ->
# Integrations -> Click & Drop API).
# ROYAL_MAIL_SERVICE_CODE is optional — leave unset to use your account's default
# configured service. If you want to force a specific service, it's account-specific
# and there's no lookup endpoint; get the exact code from your Click & Drop dashboard
# (DevTools -> Network tab while manually booking that service) or Royal Mail support.
# ROYAL_MAIL_CARRIER_NAME is only required if your account has multiple carriers.
ROYAL_MAIL_API_KEY="..."
ROYAL_MAIL_SERVICE_CODE=""
ROYAL_MAIL_CARRIER_NAME=""
