# Get sandbox keys from https://developer.paypal.com -> Apps & Credentials -> Sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID="sandbox-client-id..."
PAYPAL_CLIENT_SECRET="sandbox-client-secret..."
# "sandbox" while testing, "live" once you switch to real Live app credentials
PAYPAL_MODE="sandbox"
